                <span class="badge" :class="roleBadgeClass(u)">{{ roleLabel(u) }}</span>
              </td>
              <td>{{ u.message_limit ?? 'Unlimited' }}</td>
              <td>{{ u.message_count }}</td>
              <td class="actions">
